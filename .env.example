# Hosted demo model. If omitted, the app falls back to local Ollama.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MATCH_MODEL=openai/gpt-oss-20b

# Free job discovery and recruiter-contact enrichment
JOOBLE_API_KEY=
HUNTER_API_KEY=

# Optional overrides
OLLAMA_MODEL=llama3.2
# COLD_EMAIL_DB=C:\absolute\path\to\cold_email_agent.db

# Safety limits (raise these only after checking provider quotas).
DAILY_SEND_LIMIT=10
DAILY_ENRICHMENT_LIMIT=2
MONTHLY_HUNTER_LIMIT=40
DAILY_MODEL_SCORING_LIMIT=50
DAILY_DRAFT_LIMIT=10
JOOBLE_REQUESTS_PER_MINUTE=10
JOOBLE_REQUESTS_PER_DAY=100
ATS_REQUESTS_PER_MINUTE=30
HUNTER_REQUESTS_PER_MINUTE=5
INBOX_SYNCS_PER_HOUR=12
